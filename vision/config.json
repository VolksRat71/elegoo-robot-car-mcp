{
  "camera": {
    "sample_rate_fps": 10,
    "frame_timeout_s": 3.0
  },

  "head_swing": {
    "enabled": true,
    "angles": [45, 90, 135],
    "settle_time_ms": 200,
    "trigger_on_stuck": true,
    "trigger_on_wall": true
  },

  "head_scan": {
    "enabled": true,
    "settle_time_ms": 150,
    "ambiguity_threshold": 10,
    "circle_detection_window": 3
  },

  "snapshots": {
    "enabled": true,
    "interval_s": 5.0,
    "save_path": "drive_snapshots",
    "max_snapshots": 50
  },

  "driving_modes": {
    "normal": {
      "cruise_speed": 35,
      "slow_speed": 25,
      "turn_speed": 40,
      "reverse_speed": 30,
      "loop_interval_ms": 200,
      "drive_duration_ms": 500,
      "turn_degrees_small": 25,
      "turn_degrees_large": 50,
      "reverse_duration_ms": 400,
      "clear_threshold": 35.0,
      "obstacle_threshold": 50.0,
      "obstacle_off_threshold": 40.0,
      "danger_threshold": 70.0,
      "wall_variance": 12.0,
      "forward_commitment_ms": 1200,
      "wall_reverse_ms": 400
    },
    "cautious": {
      "cruise_speed": 28,
      "slow_speed": 20,
      "turn_speed": 38,
      "reverse_speed": 28,
      "loop_interval_ms": 200,
      "drive_duration_ms": 850,
      "turn_degrees_small": 25,
      "turn_degrees_large": 60,
      "reverse_duration_ms": 500,
      "clear_threshold": 40.0,
      "obstacle_threshold": 55.0,
      "obstacle_off_threshold": 45.0,
      "danger_threshold": 75.0,
      "wall_variance": 12.0,
      "forward_commitment_ms": 1500,
      "wall_reverse_ms": 500
    }
  },

  "smoothing": {
    "ema_alpha": 0.3
  },

  "safety": {
    "max_consecutive_stops": 5,
    "max_vision_failures": 8
  },

  "connection": {
    "robot_host": "192.168.4.1",
    "robot_port": 100,
    "camera_url": "http://192.168.4.1:81/stream",
    "vision_service_url": "http://localhost:8765"
  }
}
